// Находим элементы страницы

const content = document.getElementById("content");

const buttons = document.querySelectorAll(".nav-btn");


// Функция создания HTML-элементов

function createElement(tag, className, text) {
    const element = document.createElement(tag);

    if (className) {
        element.className = className;
    }

    if (text !== undefined) {
        element.textContent = text;
    }

    return element;
}


// Функция переключения разделов

function showPage(pageName) {

    const page = pages[pageName];

    // Проверка существования страницы
    if (!page) {
        content.textContent = "Раздел не найден";
        return;
    }

    // Очистка предыдущего содержимого
    content.replaceChildren();

    // Создание заголовка и описания
    const tag = createElement(
        "p", "page-tag", page.tag
    );

    const title = createElement(
        "h1", "page-title", page.title
    );

    const description = createElement(
        "p", "description", page.description
    );

    // Контейнер карточек
    const cards = createElement("div", "cards");

    // Цикл создания карточек
    page.items.forEach(item => {

        const card = createElement("div", "card");

        // Если открыта вкладка "Навыки"
        if (page.type === "skills") {

            const header = createElement(
                "div", "skill-header"
            );

            const skillName = createElement(
                "h3", "", item.name
            );

            const percent = createElement(
                "span", "skill-percent",
                item.level + "%"
            );

            header.append(skillName, percent);

            const progress = createElement(
                "div", "progress"
            );

            const bar = createElement(
                "div", "progress-bar"
            );

            bar.style.width = item.level + "%";

            progress.appendChild(bar);

            card.append(header, progress);

        } else {

            // Обычная карточка
            const heading = createElement(
                "h3", "", item.name
            );

            const text = createElement(
                "p", "", item.value
            );

            card.append(heading, text);

            // Дополнительная информация о проекте
            if (page.type === "projects") {

                const tech = createElement(
                    "span", "project-tag",
                    item.tech
                );

                card.appendChild(tech);
            }
        }

        cards.appendChild(card);
    });

    // Добавление элементов на страницу
    content.append(tag, title, description, cards);

    // Выделение активной вкладки
    buttons.forEach(button => {

        const active = button.dataset.page === pageName;

        button.classList.toggle("active", active);

        if (active) {
            button.setAttribute("aria-current", "page");
        } else {
            button.removeAttribute("aria-current");
        }
    });

    // Дополнительная функция:
    // запоминаем последнюю открытую вкладку

    try {
        localStorage.setItem("lastPortfolioPage", pageName);
    } catch (error) {
        console.log("Не удалось сохранить вкладку");
    }
}


// Обработка нажатий через addEventListener

buttons.forEach(button => {

    button.addEventListener("click", function() {

        const pageName = this.dataset.page;

        showPage(pageName);

    });

});


// Восстановление последней вкладки

let savedPage = "about";

try {
    savedPage = localStorage.getItem("lastPortfolioPage") || "about";
} catch (error) {
    savedPage = "about";
}


// Отображение первой страницы

showPage(pages[savedPage] ? savedPage : "about");
