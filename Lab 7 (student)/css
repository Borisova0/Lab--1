* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #080d1a;
    color: #e2e8f0;
    min-height: 100vh;
}

/* Общий контейнер */

.app {
    display: flex;
    min-height: 100vh;
}

/* Боковое меню */

.sidebar {
    width: 275px;
    background: #101827;
    border-right: 1px solid #253047;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: bold;
    color: white;
    margin-bottom: 45px;
}

.logo-icon {
    background: #2563eb;
    padding: 9px;
    border-radius: 10px;
    color: white;
}

/* Профиль */

.profile {
    text-align: center;
    padding-bottom: 35px;
}

.avatar {
    width: 90px;
    height: 90px;
    margin: 0 auto 20px;
    border-radius: 22px;
    background: linear-gradient(135deg, #2563eb, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 31px;
    font-weight: bold;
    color: white;
    box-shadow: 0 8px 25px #2563eb40;
}

.profile h2 {
    font-size: 19px;
    margin-bottom: 8px;
}

.profile p {
    color: #94a3b8;
    font-size: 14px;
}

.status {
    display: inline-block;
    margin-top: 15px;
    color: #4ade80;
    background: #143527;
    border-radius: 20px;
    padding: 8px 12px;
    font-size: 12px;
}

.menu-title {
    color: #64748b;
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

/* Навигация */

.navigation {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.nav-btn {
    width: 100%;
    background: transparent;
    border: none;
    color: #94a3b8;
    text-align: left;
    padding: 15px;
    border-radius: 12px;
    font-size: 15px;
    cursor: pointer;
    transition: 0.3s;
}

.nav-btn:hover {
    background: #1e293b;
    color: white;
}

.nav-btn.active {
    background: #2563eb;
    color: white;
    font-weight: bold;
}

.sidebar-bottom {
    margin-top: auto;
    padding-top: 30px;
    color: #64748b;
    font-size: 12px;
    line-height: 2;
}

/* Основной контент */

.main {
    flex: 1;
    min-width: 0;
    padding: 35px 50px;
    display: flex;
    flex-direction: column;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #253047;
    padding-bottom: 25px;
    color: #94a3b8;
    font-size: 14px;
}

.year {
    background: #1e293b;
    padding: 8px 15px;
    border-radius: 20px;
}

#content {
    width: 100%;
    max-width: 1000px;
    padding-top: 45px;
    animation: fadeIn 0.4s ease;
}

.page-tag {
    color: #60a5fa;
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.page-title {
    font-size: 38px;
    color: white;
    margin-bottom: 15px;
}

.description {
    color: #94a3b8;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 35px;
    max-width: 650px;
}

/* Карточки */

.cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.card {
    background: #151f30;
    padding: 25px;
    border: 1px solid #293449;
    border-radius: 16px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #3b82f6;
    box-shadow: 0 10px 30px #00000030;
}

.card h3 {
    color: #60a5fa;
    margin-bottom: 12px;
    font-size: 17px;
}

.card p {
    color: #cbd5e1;
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

/* Навыки */

.skill-header {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 17px;
}

.skill-header h3 {
    margin: 0;
}

.skill-percent {
    color: #93c5fd;
    font-size: 14px;
}

.progress {
    width: 100%;
    height: 9px;
    background: #334155;
    border-radius: 10px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #8b5cf6);
    border-radius: 10px;
}

/* Проекты */

.project-tag {
    display: inline-block;
    color: #a5b4fc;
    background: #25244b;
    font-size: 12px;
    padding: 7px 12px;
    border-radius: 20px;
    margin-top: 15px;
}

/* Подвал */

footer {
    color: #64748b;
    margin-top: auto;
    padding-top: 50px;
    font-size: 13px;
}

/* Анимация */

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Адаптация под телефон */

@media (max-width: 800px) {
    .app {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        padding: 20px;
    }

    .logo {
        margin-bottom: 25px;
    }

    .profile {
        padding-bottom: 20px;
    }

    .navigation {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .sidebar-bottom {
        display: none;
    }

    .main {
        padding: 25px 20px;
    }

    #content {
        padding-top: 30px;
    }

    .page-title {
        font-size: 28px;
    }
}

@media (max-width: 550px) {
    .cards {
        grid-template-columns: 1fr;
    }

    .nav-btn {
        font-size: 13px;
        padding: 12px;
    }
}
