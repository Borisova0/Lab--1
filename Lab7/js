const content = document.getElementById("content");
const buttons = document.querySelectorAll(".tab");

// Функция отображения выбранной страницы
function showPage(pageName) {
    const page = pages[pageName];

    if (!page) {
        content.textContent = "Страница не найдена";
        return;
    }

    // Очистка предыдущего содержимого
    content.replaceChildren();

    // Создание заголовка
    const title = document.createElement("h2");
    title.textContent = page.title;

    // Создание описания
    const description = document.createElement("p");
    description.className = "description";
    description.textContent = page.description;

    // Контейнер для карточек
    const grid = document.createElement("div");
    grid.className = "info-grid";

    // Создание карточек через цикл
    page.items.forEach(item => {
        const card = document.createElement("div");
        card.className = "info-card";

        const heading = document.createElement("h3");
        heading.textContent = item.name;

        const text = document.createElement("p");
        text.textContent = item.value;

        card.append(heading, text);
        grid.appendChild(card);
    });

    content.append(title, description, grid);

    // Выделение активной вкладки
    buttons.forEach(button => {
        const isActive = button.dataset.page === pageName;

        button.classList.toggle("active", isActive);
        button.setAttribute("aria-current", isActive ? "page" : "false");
    });

    // Запоминание последней вкладки
    try {
        localStorage.setItem("lastPage", pageName);
    } catch (error) {
        console.log("Сохранение вкладки недоступно");
    }
}

// Обработка нажатий на вкладки
buttons.forEach(button => {
    button.addEventListener("click", () => {
        showPage(button.dataset.page);
    });
});

// Загрузка последней открытой вкладки
let savedPage = "about";

try {
    savedPage = localStorage.getItem("lastPage") || "about";
} catch (error) {
    savedPage = "about";
}

showPage(pages[savedPage] ? savedPage : "about");
